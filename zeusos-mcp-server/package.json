{
  "name": "zeusos-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for ZeusOS — query and analyze advisory projects, finance (CFO briefing, spend plans, cash flow), strategy (OKRs/KPIs), quotes, and intelligence from Firestore.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^10.6.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
