# =============================================================================
# ZeusOS — Environment Configuration (Example)
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Firebase web SDK keys are safe to ship to the browser; security is enforced
# via Firestore Rules + Auth domain restrictions, not key secrecy.

# -----------------------------------------------------------------------------
# App identity
# -----------------------------------------------------------------------------
VITE_APP_ENV=development
VITE_APP_NAME=ZeusOS
VITE_APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# Firebase project: ZeusOS (project number 746031933844)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=zeusos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zeusos
VITE_FIREBASE_STORAGE_BUCKET=zeusos.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=746031933844
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Emulator (Development)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_PORT=9099
VITE_STORAGE_EMULATOR_PORT=9199

# -----------------------------------------------------------------------------
# Dev-only auth bypass (Phase 6.UI.0)
# -----------------------------------------------------------------------------
# Set to `true` in `.env.local` for local browser verification of the
# sidebar / module surfaces without signing in. Synthesises an admin
# DawinUser with parent-org access on `zeus-group` plus all 5
# sub-brands, so the PARENT manifest renders and the org switcher
# can flip into any subsidiary. Guarded on `import.meta.env.DEV`, so
# production builds drop the code path entirely. NEVER set this in
# a deployed environment.
VITE_DEV_BYPASS_AUTH=false

# -----------------------------------------------------------------------------
# Google APIs (OAuth, Drive)
# -----------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# -----------------------------------------------------------------------------
# AI Configuration
# -----------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_AI_ENABLED=true
VITE_AI_MODEL=gemini-pro

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
VITE_FEATURE_INTELLIGENCE=true
VITE_FEATURE_HR_CENTRAL=true
VITE_FEATURE_CEO_STRATEGY=true
VITE_FEATURE_FINANCIAL=true
VITE_FEATURE_STAFF_PERFORMANCE=true
VITE_FEATURE_CAPITAL_HUB=false
VITE_FEATURE_MARKET_INTELLIGENCE=true
VITE_FEATURE_OFFLINE_MODE=true

# ZeusOS-specific feature flags (Phase 1+)
VITE_FEATURE_CAMPAIGNS=true
VITE_FEATURE_MEDIA_PLAN=true
VITE_FEATURE_PRODUCTION=true
VITE_FEATURE_TALENT_ROSTER=true
VITE_FEATURE_ASSET_LIBRARY=true

# -----------------------------------------------------------------------------
# Locale (Uganda primary, Kenya secondary)
# -----------------------------------------------------------------------------
VITE_DEFAULT_CURRENCY=UGX
VITE_DEFAULT_LOCALE=en-UG
VITE_DEFAULT_TIMEZONE=Africa/Kampala

# -----------------------------------------------------------------------------
# Analytics & Monitoring (Phase 5.F)
# -----------------------------------------------------------------------------
# Firebase Analytics (GA4) ships when ALL three are true:
#   1. VITE_ANALYTICS_ENABLED=true
#   2. VITE_FIREBASE_MEASUREMENT_ID set to a real GA4 stream ID (G-XXXXXXXXXX)
#      ← grab from Firebase Console → Project Settings → Your Apps → web → Stream ID
#   3. Browser supports analytics (some embedded/privacy-mode browsers don't)
# `src/shared/services/firebase/analytics.ts` auto-tags every authenticated
# session with the user's UID via `onAuthChange`. Disabled by default in
# `.env.example` to keep dev consoles clean — flip the two vars when wiring
# the production env.
VITE_ANALYTICS_ENABLED=true

# Sentry error reporting (optional — Phase 5.F follow-up).
# When set, the frontend boots the Sentry SDK and the ErrorBoundary
# reports unhandled exceptions there. Leave blank to disable.
VITE_SENTRY_DSN=your_sentry_dsn
VITE_PERFORMANCE_MONITORING=true

# -----------------------------------------------------------------------------
# Notion (used in Cloud Functions for client/project mirror — optional)
# -----------------------------------------------------------------------------
NOTION_API_KEY=your_notion_api_key

# -----------------------------------------------------------------------------
# QuickBooks Online integration (Phase 5 — optional until confirmed by Zeus)
# -----------------------------------------------------------------------------
QBO_CLIENT_ID=your_qbo_client_id
QBO_CLIENT_SECRET=your_qbo_client_secret
QBO_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------------
# Drive Bridge (Cloud Functions — backend only, no VITE_ prefix)
# -----------------------------------------------------------------------------
DRIVE_ACTIVE_PROJECTS_FOLDER_ID=
DRIVE_ARCHIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
