    // COLLECTION GROUP RULES
    // Required for cross-project collectionGroup queries
    // ============================================

    // Allow collectionGroup queries on designItems (used by CRM + Manufacturing)
    match /{path=**}/designItems/{itemId} {
      allow read: if isAuthenticated();
    }

    // ============================================
    // SHOPIFY INTEGRATION
    // ============================================

    match /shopifyProducts/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /shopifyOrders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // AI EXTENSIONS
    // ============================================

    match /aiPredictions/{predictionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /aiSuggestions/{suggestionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Advisory AI Conversations
    match /aiConversations/{conversationId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ============================================
    // FINANCE - CASH FLOW MANAGEMENT
    // ============================================

    match /accounts/{accountId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /cash_transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /cash_forecasts/{forecastId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /bank_reconciliations/{reconciliationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /cashForecasts/{forecastId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ============================================
    // DESIGN MANAGER - CLIENT PORTAL SHARES
    // ============================================

    match /clientPortalShares/{shareId} {
      // Public read for shared portal links (accessed by unauthenticated clients)
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /quoteComparisonGroups/{groupId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ============================================
    // ADVISORY DELIVERY - MONITORING & REPORTING
    // ============================================

    match /variance_investigations/{investigationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /reconciliation_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /document_export_status/{statusId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /export_configurations/{configId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /export_jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /deadline_monitoring_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /document_export_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

