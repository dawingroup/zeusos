    // SYNC & INTEGRATION LOGS
    // ============================================

    match /syncLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /embeddings/{embeddingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /commitmentSnapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // Compliance Module
    // ============================================

    match /complianceDocuments/{documentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /complianceObligations/{obligationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ============================================
    // Manufacturing MES Collections
    // ============================================

    match /manufacturingOrders/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();

      // Steps subcollection
      match /steps/{stepId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAdmin();
      }

      // BOM subcollection
      match /bom/{lineId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Quality events subcollection
      match /quality_events/{eventId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /workstations/{workstationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /routing_templates/{templateId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /productionReports/{reportId} {
      allow read: if isAuthenticated();
      allow create, update: if false; // Cloud Functions only
    }

    // Workshop Viewer — AI part identification learning store
    match /part_identifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Furniture Type Knowledge Base — continuously editable by admins
    match /furniture_types/{typeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Design Revisions — Workshop Viewer revision timeline
    match /designRevisions/{revisionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Furniture Templates — ParametricConfigurator template library
    match /furnitureTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Media Supplier Invoices — Phase 4 upstream emitter for PO + JE flow
    // (audit copy; deployed source at firestore.rules)
    match /media_supplier_invoices/{invoiceId} {
      allow read: if isStaffAuth();
      allow create: if isStaffAuth();
      allow update: if isParentOrgPrincipal();
      allow delete: if isAdmin();
    }

    // Purchase Orders — Phase 4.1 procurement anchor (talent + media suppliers)
    // CFn-only write. Parent-org-only read (supplier costs leak otherwise).
    match /purchase_orders/{poId} {
      allow read: if isAdmin() || isParentOrgPrincipal();
      allow write: if false;
    }

    // Journal Entries — Phase 4.1 GL posting (POs + client invoices)
    // CFn-only write. Parent-org-only read.
    match /journal_entries/{jeId} {
      allow read: if isAdmin() || isParentOrgPrincipal();
      allow write: if false;
    }
  }
}
