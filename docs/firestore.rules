      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Profile Snapshots (point-in-time metrics)
    match /profile_snapshots/{snapshotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    // Tracked Topics (discussion monitoring)
    match /tracked_topics/{topicId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Topic Mentions (discovered discussions)
    match /topic_mentions/{mentionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
