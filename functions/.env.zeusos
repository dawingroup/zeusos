# Firebase Functions deploy-time params for the `zeusos` project.
#
# This file is loaded automatically by `firebase deploy` when the
# active project is `zeusos` (see firebase.json + .firebaserc). It
# provides values for every `defineString()` param that doesn't have
# a non-empty default in code — without this, deploys fail in
# non-interactive (CI) mode with:
#
#   Error: In non-interactive mode but have no value for the
#   following environment variables: QUICKBOOKS_REDIRECT_URI, ...
#
# Empty / placeholder values mean the feature is DISABLED at runtime:
# the corresponding code paths gate on `Boolean(value)` and short-
# circuit when the value is falsy (see e.g. functions/src/drive/
# config.js `isDriveMirrorEnabled()`).
#
# This file is NON-SECRET and intentionally checked in. Real secrets
# (API keys, OAuth client secrets, service-account private keys)
# stay in Secret Manager via `defineSecret()` — those are never
# committed.
#
# The DawinOS-era integrations these vars feed (QuickBooks, Notion,
# Meta WhatsApp, Drive bridge) are kept wired but disabled pending
# the plan §12 open items (#3 QBO, #5 Drive assets, #4 data import).
# A follow-up PR will strip the dead code paths entirely.

# QuickBooks Online — deferred. Plan §12 open item #3.
# When enabling, set to: https://<your-region>-zeusos.cloudfunctions.net/qbCallback
QUICKBOOKS_REDIRECT_URI=

# Meta (WhatsApp / Facebook / Instagram) OAuth — deferred. Plan §4 P4 integration.
# When enabling, set to: https://os.zeustheagency.com/integrations/meta/oauth-callback
META_OAUTH_REDIRECT_URI=

# Notion — deferred. Plan §3 lists Notion as "optional".
NOTION_API_KEY=

# Google Drive bridge — deferred. Plan §3 lists Drive as keep, but
# folder IDs aren't provisioned until Phase 5.E.
# When enabling, set both to the corresponding Drive folder IDs.
DRIVE_ACTIVE_PROJECTS_FOLDER_ID=
DRIVE_ARCHIVE_FOLDER_ID=
